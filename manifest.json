{
  "manifest_version": 3,
  "name": "荣耀笔记导出器",
  "version": "0.2.0",
  "description": "在浏览器里把荣耀云笔记导出为 Markdown 与原图 ZIP，无需安装其他软件。",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://cloud.honor.com/*", "https://fileproxy-drcn.cloud.honor.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "荣耀笔记导出器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://cloud.honor.com/portal/notepad*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
